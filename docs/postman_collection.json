{
  "info": {
    "name": "iOS5Team1 API",
    "description": "Postman collection template for iOS5Team1 Vapor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"nickname\": \"tester\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.access) {",
                  "  pm.collectionVariables.set('access_token', json.access);",
                  "}",
                  "if (json && json.refresh) {",
                  "  pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.access) {",
                  "  pm.collectionVariables.set('access_token', json.access);",
                  "}",
                  "if (json && json.refresh) {",
                  "  pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout"
          }
        },
        {
          "name": "Nickname Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"tester\"\n}"
            },
            "url": "{{base_url}}/auth/nickname-check"
          }
        },
        {
          "name": "Nickname Update",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"newNickname\"\n}"
            },
            "url": "{{base_url}}/auth/nickname-update"
          }
        },
        {
          "name": "Social Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"idToken\": \"<google_id_token>\",\n  \"deviceId\": \"ios-device-001\"\n}"
            },
            "url": "{{base_url}}/auth/social"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.access) {",
                  "  pm.collectionVariables.set('access_token', json.access);",
                  "}",
                  "if (json && json.refresh) {",
                  "  pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Social Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"providerUid\": \"<uid>\",\n  \"nickname\": \"tester\",\n  \"email\": \"test@example.com\",\n  \"deviceId\": \"ios-device-001\"\n}"
            },
            "url": "{{base_url}}/auth/social-register"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Create Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"tester\",\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}"
            },
            "url": "{{base_url}}/profile"
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"new_name\",\n  \"avatarUrl\": \"https://example.com/new.png\"\n}"
            },
            "url": "{{base_url}}/profile"
          }
        }
      ]
    },
    {
      "name": "R2",
      "item": [
        {
          "name": "Presign Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"avatar.png\",\n  \"expiresIn\": 900\n}"
            },
            "url": "{{base_url}}/r2/presign"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameId\": 123,\n  \"rating\": 5,\n  \"content\": \"Great game!\"\n}"
            },
            "url": "{{base_url}}/reviews"
          }
        },
        {
          "name": "Update Review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"content\": \"Updated review\"\n}"
            },
            "url": "{{base_url}}/reviews/1"
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/reviews/1"
          }
        },
        {
          "name": "Get Reviews By Game",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reviews/game/123?sort=latest"
          }
        },
        {
          "name": "Get Review Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reviews/game/123/stats"
          }
        },
        {
          "name": "Get My Reviews",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/reviews/me"
          }
        }
      ]
    },
    {
      "name": "IGDB",
      "item": [
        {
          "name": "Multiquery",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": {
              "mode": "raw",
              "raw": "query games \"Example\" { fields name,first_release_date; where id = 1942; };"
            },
            "url": "{{base_url}}/v4/multiquery"
          }
        },
        {
          "name": "Games",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": {
              "mode": "raw",
              "raw": "fields name,first_release_date; where id = 1942;"
            },
            "url": "{{base_url}}/v4/games"
          }
        }
      ]
    },
    {
      "name": "Firebase",
      "item": [
        {
          "name": "Get Firebase Config",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/firebase/config"
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Login Wrong Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"wrong_password\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Refresh Invalid Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"INVALID\"\n}"
            },
            "url": "{{base_url}}/auth/refresh"
          }
        },
        {
          "name": "Nickname Update Without Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"newNickname\"\n}"
            },
            "url": "{{base_url}}/auth/nickname-update"
          }
        },
        {
          "name": "Profile Get Without Token",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/profile"
          }
        },
        {
          "name": "Social Unsupported Provider",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"unknown\",\n  \"idToken\": \"INVALID\",\n  \"deviceId\": \"ios-device-001\"\n}"
            },
            "url": "{{base_url}}/auth/social"
          }
        }
      ]
    }
  ]
}
